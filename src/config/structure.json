{
  "_todo": "TODO: tune after testing the real prototypes. Heights are in cm; grip and stiffness run from 0 (none) to 1 (very strong).",
  "plant": { "domeTop": 9, "clearance": 1 },
  "base": {
    "cup": { "height": 12 },
    "tower": { "height": 10 },
    "easel": { "height": 4 }
  },
  "wedgeHeight": 3,
  "posts": {
    "thickStraw": { "height": 8, "stiffness": 0.6 },
